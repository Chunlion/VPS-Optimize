server {
    listen 80;

    server_name proxy.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;

    server_name proxy.example.com;

    ssl_certificate /etc/caddy/certs/proxy.example.com.crt;
    ssl_certificate_key /etc/caddy/certs/proxy.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    location / {
    # vps-optimize-ip-whitelist-start
    allow 198.51.100.10;
    allow 2001:db8::/32;
    deny all;
    # vps-optimize-ip-whitelist-end
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vps_proxy_connection_upgrade;

        proxy_pass http://127.0.0.1:40000;
    }
}
